#!/bin/bash
source ~/Repositories/scripts/essential-functions
watch_history_yt="$HOME/Misc/Backups/video/watch-history-youtube.csv"
watch_history_docs="$HOME/Misc/Backups/video/watch-history-docs.csv"
watch_history_tv="$HOME/Misc/Backups/video/watch-history-tv.csv"
watch_history_film="$HOME/Misc/Backups/video/watch-history-film.csv"

function check-watchfile {
    [[ -z "$2" ]] && {
	echolor red ":: function check-watchfile returned an error!"
	exit 1
    }
    [[ ! -e "$1" ]] && {
	echolor yellow ":: ““$1”” created"
	echo "$2" > "$1"
    } 
}

check-watchfile "$watch_history_yt" "title,channel,duration,time"
check-watchfile "$watch_history_docs" "title,time"
check-watchfile "$watch_history_film" "title,time"
check-watchfile "$watch_history_tv" "show,episode,time"

function channel-views {
    xan select channel,duration "$watch_history_yt"        \
	| xan groupby channel 'count(channel) as views'    \
	| xan sort -NR -s views                            \
	| xan enum -S 1 -c rank
}

function channel-watchtimes {
    xan select channel,duration "$watch_history_yt"           \
	| xan groupby channel 'sum(duration) as duration'     \
	| xan sort -NR -s duration                            \
	| xan transform duration 'idiv(duration, 60)'         \
	| xan enum -S 1 -c rank
}

function redownload-video {
    redownload_id="$(xan select title "$watch_history_yt" | sort | uniq | fzf | awk -F '[' '{print $2}' | awk -F ']' '{print $1}')"
    [[ "$(wc -m <<< "$redownload_id")" != "12" ]] && {
	echolor red ":: Not a YouTube ID."
	exit 1
    }
    ThyPipe "https://www.youtube.com/watch?v=$redownload_id" &
}

function share-video {
    share_id="$(xan select title "$watch_history_yt" | sort | uniq | fzf | awk -F '[' '{print $2}' | awk -F ']' '{print $1}')"
    [[ "$(wc -m <<< "$share_id")" != "12" ]] && {
	echolor red ":: Not a YouTube ID."
	exit 1
    }
    qr_file="$(random-string).png"
    zint --scale 5 --barcode qrcode --data "https://youtu.be/$share_id" --output /tmp/"$qr_file"
    sxiv /tmp/"$qr_file"
    echo "https://youtu.be/$share_id"
    echo "https://youtu.be/$share_id" | tr -d "'\n" | xclip -selection clipboard
}
    
case "$1" in
    "yt"|"youtube")
	xan tail -l 24 "$watch_history_yt" | xan view -s title,channel,time -HMR --cols 0.9 --color=always --theme="striped" | sed '/^$/d'
	;;
    "tv"|"show"|"shows")
	xan tail -l 24 "$watch_history_tv" | xan view -HMR --cols 0.99 --color=always --theme="striped" | sed '/^$/d'
	;;
    "doc"|"docs"|"documentaries"|"documentary")
	xan tail -l 24 "$watch_history_docs" | xan view -HMR --color=always --theme="striped" | sed '/^$/d'
	;;
    "film"|"films"|"movies"|"movie"|"mov")
	xan tail -l 24 "$watch_history_film" | xan view -HMR --color=always --theme="striped" | sed '/^$/d'
	;;
    "hist"|"history"|"all")
	duration_secs="$(xan select duration "$watch_history_yt" | xan behead | paste -sd+ | bc)"
	duration_days="$(units "$duration_secs seconds" 'millennia;centuries;years;months;days;hours;minutes;seconds' | sed 's/\t//g;s/ + /, /g')"
	echo -n "YouTube ($(xan count "$watch_history_yt")) $duration_secs seconds = $duration_days"
	xan tail -l 4 "$watch_history_yt" | ifne xan view -s title,channel,time --cols 0.99 -HMR --color=always --theme="striped" | sed '/^$/d' 
	echo -n "Films ($(xan count "$watch_history_film"))"
	xan tail -l 4 "$watch_history_film" | ifne xan view -HMR --cols 0.99 --color=always --theme="striped" | sed '/^$/d'	    
	echo -n "TV ($(xan count "$watch_history_tv"))"
	xan tail -l 4 "$watch_history_tv" | ifne xan view --cols 0.99 -HMR --color=always --theme="striped" | sed '/^$/d'	    
	echo -n "Documentaries ($(xan count "$watch_history_docs"))"
	xan tail -l 4 "$watch_history_docs" | ifne xan view -HMR --cols 0.99 --color=always --theme="striped" | sed '/^$/d'	    
	;;
    "fav"|"star"|"stars"|"starred")
	echo '🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟'
	xan select title,channel "$watch_history_yt"             \
	    | rg -N '🌟'                                        \
	    | sed 's/🌟//g'                                     \
	    | sort                                              \
	    | uniq                                              \
	    | cut -c 18-                                        \
	    | xan view -nMRA --color=always --theme="striped"
	echo '🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟🌟'
	;;
    "rank"|"channel"|"channels")
	xan cat columns                                 \
	    <(channel-views | xan select views,channel) \
	    <(channel-watchtimes)                       \
	    | xan view -MRIpAr 1
	;;
    "redownload"|"download"|"thypipe"|"pipe"|"tp")
	redownload-video
	;;
    "share"|"qr")
	share-video
	;;
    *)
	:
	;;
esac
	
[[ -z "$1" ]] || exit
ep="$(eza --no-quotes -1fX --show-symlinks | sed '/^$/d' | sort | grep -E 'mkv$|avi$|mp4$|ts$|mov$|webm$|m4v$' | ifne fzf)"
jsonep="$HOME/Excluding/youtube/.${ep%mp4}json"
[[ -z "$ep" ]] && exit
[[ -e "$jsonep" ]] && {
    jq -r '.description' "$jsonep" | pad-and-wrap w70
    echolor white '------------------------------------------------------------'
    echolor white 'Title:  \t' 1
    title_arrow="$(jq -r '.title' "$jsonep" | tr -d '<>')"
    sed 1q <<< "$title_arrow" | pad-and-wrap w45p16h
    jq -e '.original_title' "$jsonep" >/dev/null && {
	title_orig="$(jq -r '.original_title' "$jsonep")"
	cmp -s <(echo "$title_arrow") <(echo "$title_orig") || {
	    echolor white '\t\t' 1
	    echolor ashy "$(echo "$title_orig" | pad-and-wrap w45p16h)"
	}
    }
    echolor white 'Channel:\t' 1
    channel="$(jq -r '.channel' "$jsonep" | sed 1q)"
    [[ "$channel" = null ]] && channel="$(jq -r '.uploader' "$jsonep" | sed 1q)"
    echo "$channel"
    echolor white 'Uploaded:\t' 1
    date -Idate -d "$(jq -r '.upload_date' "$jsonep" | sed 1q)"
    echolor white 'Downloaded:\t' 1
    date -Idate -d "$(stat -c '%w' "$ep")"
    echolor white 'Duration:\t' 1
    units "$(jq -r '.duration' "$jsonep" | sed 1q) seconds" 'hours;minutes;seconds' | sed 's/^	*//;s/\t//g;s/ + /, /g'
    function get-rank-stat {
	channel-views | xan search -s channel -e "$channel" | xan select "$1" | xan behead
    }
    [[ -n "$(get-rank-stat views)" ]] && {
	echolor white 'Times watched:\t' 1
	watch_instance="$(rg -- "$(echo "$ep" | between '[' ']')" "$watch_history_yt" | wc -l | sed 's/^0$/““0””/')"
	echolor yellow-default "$watch_instance"
	echolor white 'View rank:\t' 1
	echo -n "#$(get-rank-stat rank) by views ("
	echo -n "$(get-rank-stat views) times)"
	echo
	echolor white 'Time rank:\t' 1
	echo -n "#$(channel-watchtimes | xan search -s channel -e "$channel" | xan select rank | xan behead) by watchtime ("
	echo -n "$(units "$(channel-watchtimes | xan search -s channel -e "$channel" | xan select duration | xan behead) minutes" 'days;hours;minutes' | sed 's/\t//g;s/ + /, /g'))"
	echo
    } || {
	echolor white 'View rank:\t' 1
	echolor yellow "First time"
    }
    echolor white '------------------------------------------------------------'
} || {
    if pwd | grep -q "$HOME/Excluding/youtube"
    then
	echolor yellow ":: Data file not found."
	exit 1
    fi
}
mpv --write-filename-in-watch-later-config --msg-level=all=error --osd-fractions --volume=100 --volume-max=200 --alang=eng --slang=eng "$ep" || exit
ext_alone="$(echo "$ep" | awk -F '.' '{print $NF}')"
allrelatedfiles="$(echo "$ep" | sed "s/\.$ext_alone//;s/,/‚/g")"

############ YT

function yt-done {
    {
	echo -ne "$addstar$allrelatedfiles,"
	echo -ne "$channel,"
	echo -ne "$(jq '.duration' "$HOME/Excluding/youtube/.$allrelatedfiles".json | sed 1q),"
	echo  -e "$(date -Isec)"
    } >> "$watch_history_yt"
    move-to-trash "$allrelatedfiles"*
    [[ -e "$HOME/Excluding/youtube/.$allrelatedfiles".json ]] && {
	move-to-trash "$HOME/Excluding/youtube/.$allrelatedfiles".json
    } || {
	echolor red ':: JSON data file not found'
    }			
    echolor green ":: Logged into the YouTube record $addstar"
}

function tv-done {
    {
	echo -ne "$(pwd | awk -F '/' '{print $5}'),"
	echo -ne "$(tr -d ',' <<< "$allrelatedfiles"),"
	echo -e "$(date -Isec)"
    } >> "$watch_history_tv"
    move-to-trash-recursively "$allrelatedfiles"*
    echolor green ":: Logged into the TV record"
}

function doc-done {
    {
	echo -ne "$allrelatedfiles,"
	echo -e "$(date -Isec)"
    } >> "$watch_history_docs"
    move-to-trash-recursively "$allrelatedfiles"*
    echolor green ":: Logged into the documentaries record"
}

function film-done {
    {
	echo -ne "$allrelatedfiles,"
	echo -e "$(date -Isec)"
    } >> "$watch_history_film"
    move-to-trash-recursively "$allrelatedfiles"*
    echolor green ":: Logged into the film record"
}

function abandon-file {
    move-to-trash "$allrelatedfiles"*
    [[ "$1" = "video" ]] && {
	[[ -e "$HOME/Excluding/youtube/.$allrelatedfiles".json && "$1" ]] && {
	    move-to-trash "$HOME/Excluding/youtube/.$allrelatedfiles".json
	} || {
	    echolor red ':: JSON data file not found'
	}
    }
    echolor yellow ":: The ${1:-file} ““$allrelatedfiles””\n:: has been abandoned"
}

function do-nothing {
    echolor yellow ":: Nothing was done"
}

function yt-comments {
    	    rg -q '"comments"' "$HOME/Excluding/youtube/.$allrelatedfiles".json || {
		yt-dlp -v -j -R 2  --write-comments                                            \
		       --extractor-args "youtube:comment_sort=top;max_comments=100,100,0,0,1"  \
		       "https://youtu.be/$(printf "$allrelatedfiles" | between '[' ']')"       \
		       > "$HOME/Excluding/youtube/.$allrelatedfiles".json
	    }
	    jq -r                                                                                       \
	       '.comments.[] | .author, "📣" , ._time_text, "👍", .like_count, "", .text, ""'          \
	       "$HOME/Excluding/youtube/.$allrelatedfiles".json                                         \
		| pad-and-wrap 60 |  bat -l txt --theme 'Solarized (dark)' 
}


if pwd | grep -q "$HOME/Excluding/youtube"
then
    choose_done="$(echo -e 'Mark as done\nDo nothing\nAbandon file\nDone and star\nSee comments' | fzf --no-input)"
    [[ "$choose_done" = "Done and star" ]] && addstar='🌟'|| addstar=''
    case "$choose_done" in
	"Mark as done"|"Done and star")
	    yt-done ;;
	"Abandon file")
	    abandon-file video ;;
	"Do nothing")
	    do-nothing ;;
	"See comments")
	    yt-comments
	    choose_done="$(echo -e 'Mark as done\nDo nothing\nAbandon file\nDone and star' | fzf --no-input)"
	    case "$choose_done" in
		"Mark as done"|"Done and star")
		    yt-done ;;
		"Abandon file")
		    yt-abandon ;;
		"Do nothing")
		    do-nothing ;;
	    esac
	    ;;
    esac
    exit
fi

### TV

if pwd | grep -q "$HOME/TV"
then
    choose_done="$(echo -e 'Mark as done\nDo nothing\nAbandon file' | fzf --no-input)"
    case "$choose_done" in
	"Mark as done")
	    tv-done ;;
	"Abandon file")
	    abandon-file episode ;;
	"Do nothing")
	    do-nothing ;;
    esac
    exit
fi

###### Docs

if pwd | grep -q "$HOME/Excluding/documentaries"
then
    choose_done="$(echo -e 'Mark as done\nDo nothing\nAbandon file' | fzf --no-input)"
    case "$choose_done" in
	"Mark as done")
	    doc-done ;;
	"Abandon file")
	    abandon-file documentary ;;
	"Do nothing")
	    do-nothing ;;
    esac
    exit
fi

##### Film

if pwd | grep -q "$HOME/Films"
then
    choose_done="$(echo -e 'Mark as done\nDo nothing\nAbandon file' | fzf --no-input)"
    case "$choose_done" in
	"Mark as done")
	    film-done ;;
	"Abandon file")
	    abandon-file film ;;	
       	"Do nothing")
	    do-nothing ;;
    esac
    exit
fi

echolor red ":: File is outside supported directories."
exit 1
