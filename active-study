#!/bin/bash
source ~/Repositories/scripts/essential-functions

data_dir="$HOME/.local/share/zas"
sphere_file="$data_dir/sphere"
current_sphere="$(sed 1q "$sphere_file")"
[[ -z "$current_sphere" ]] && current_sphere="misc"
current_file="$data_dir/library-$current_sphere-current"
reserve_file="$data_dir/library-$current_sphere-reserve"
alldone_file="$data_dir/library-$current_sphere-alldone"
use_program="sioyek"
touch "$current_file" "$reserve_file" "$alldone_file"
    
function source-detector {
    case "$1" in
	0)
	    storage_file="$current_file"
	    destination="current"
	    ;;
	1)
	    storage_file="$reserve_file"
	    destination="reserve"
	    ;;
	2)
	    storage_file="$alldone_file"
	    destination="alldone"
	    ;;
	*)
	    echolor red ":: Incorrect source (must be 0, 1, or 2)"
	    exit 1
    esac
}

function shelf-integrity-checker {
    case "$shelf_source" in
	0) : ;;
	1) : ;;
	2) : ;;
	*) return 1 ;;
    esac
    case "$shelf_target" in
	0) : ;;
	1) : ;;
	2) : ;;
	*) return 1 ;;
    esac
    [[ "$shelf_source" = "$shelf_target" ]] && return 1
    return 0
}

function add-study {
    source-detector "$shelf_target"
    [[ -e "$1" ]] || {
	echolor red ":: Nothing found."
	exit
    }
    grep -q "$(realpath -s "$1")" "$data_dir/"* && {
	echolor red ":: This book already exists in active study."
	return 1
    }
    echo "$(realpath -s "$1")" >> $storage_file
    basic-commit "$data_dir"
    echolor purple ":: ““$(basename "$1")”” added to ““$destination””"
}

function delete-study {
    source-detector "$shelf_source"
    removethis="$(cat $storage_file | fzf --prompt="Select file to REMOVE: ")"
    [ -z "$removethis" ] && echolor red ":: Nothing chosen." && exit
    sed -i "s|^$removethis$||g;/^$/d" $storage_file
    basic-commit "$data_dir"
    echolor purple ":: ““$(echo $removethis | awk -F '/' '{print $NF}')”” was removed."
}

function open-study {
    source-detector "$shelf_source"
    openthis="$(cat $storage_file | fzf --prompt="Select file to OPEN: ")"
    [ -z "$openthis" ] && echolor red ":: Nothing chosen." && exit
    echolor purple ":: Opened ““$(echo $openthis | awk -F '/' '{print $NF}')”” in ““$use_program””"
    echo -n $openthis | xclip -selection clipboard
    ( eval "$use_program" "$openthis" 2>/dev/null >/dev/null ) &
}

function bib-study {
    source-detector "$shelf_source"
    bibthis="$(cat $storage_file | fzf --prompt="Select file to OPEN: ")"
    [ -z "$bibthis" ] && echolor red ":: Nothing chosen." && exit
    bibthisdir="$(realpath "$(dirname "$bibthis")")"
    fd -q --exact refs.bib "$bibthisdir" || {
	echolor red ":: No .bib file in said directory."
	exit
    }
    bibthiskey="$(printf "$bibthis" | awk -F '/' '{print $NF}' | sed 's/.pdf$//g')"
    case "$1" in
	"title")
	    pandoc -i "$bibthisdir"/refs.bib -f bibtex -t csljson | jq -r '.[] | select( .id == "'"$bibthiskey"'") | .title' 
	    ;;
	"doi")
	    pandoc -i "$bibthisdir"/refs.bib -f bibtex -t csljson | jq -r '.[] | select( .id == "'"$bibthiskey"'") | .DOI' 
	    ;;
	"author")
	    pandoc -i "$bibthisdir"/refs.bib -f bibtex -t csljson | jq -r '.[] | select( .id == "'"$bibthiskey"'") | .[].author.[0].family' 
	    ;;
	*)
	    pandoc -i "$bibthisdir"/refs.bib -f bibtex -t csljson | jq -r '.[] | select( .id == "'"$bibthiskey"'")'  | sed '/^$/d' | bat -pl json
	    echo -n "$bibthiskey" | xclip -selection clipboard
	    ;;
    esac
}



function move-shelf {
    shelf-integrity-checker || {
	echolor red ":: Shelf choice is incorrect!"
	echolor yellow ":: 0 = current\n:: 1 = reserve\n:: 2 = alldone"
	exit 1
    }
    source-detector "$shelf_source"
    stashthis="$(cat "$storage_file" | fzf --prompt="Select file to move from $destination: ")"
    [ -z "$stashthis" ] && echolor red ":: Nothing chosen." && exit
    sed -i "s|$stashthis||g;/^$/d" "$storage_file"
    source-detector "$shelf_target"
    echo "$stashthis" >> "$storage_file"
    basic-commit "$data_dir"
    echolor purple ":: ““$(echo $stashthis | awk -F '/' '{print $NF}')”” was moved to $destination."
}

function view-study {
    i=1
    IFS=$'\n'
    for j in $(cat "$alldone_file")
    do
	[[ "$i" -eq 1 ]] && echolor white-blue "-------- ALLDONE ““$current_sphere”” 2 --------"
	print-name "$j" blue
	((i++))
    done
    i=1
    for j in $(cat "$reserve_file")
    do
	[[ "$i" -eq 1 ]] && echolor white-green "-------- RESERVE ““$current_sphere”” 1 --------"
	print-name "$j" green
	((i++))
    done
    i=1
    for j in $(cat "$current_file")
    do
	[[ "$i" -eq 1 ]] && echolor white-purple "-------- CURRENT ““$current_sphere”” 0 --------"
	print-name "$j" purple
	((i++))
    done
    unset IFS
}

function print-name {
    full_name="$(realpath -qm "$1" | sed "s|$HOME|~|g")"
    path_string="$(dirname "$1" | sed "s|$HOME|~|g")"
    max_length=$(($(tput cols) - 8))
    replace_which=3
    function replacer {
	replace_this="$(echo -n "$path_string" | xsv select -d '/' $replace_which)"
	path_string="$(echo -n "$path_string" | sed "s|$replace_this|...|")"
	full_name="$(echo -n "$path_string")/$(basename "$1")"
    }
    while [[ "$(echo -n $full_name | wc -c)" -gt "$max_length" ]]
    do
	replacer "$1"
	((replace_which++))
    done
    case $2 in
	purple) color=35 ;;
	green) color=32 ;;
    esac	
    path_string=$(echo -n "$path_string" | sed "s|\.\.\./\.\.\./\.\.\./|.../|g;s|\.\.\.|\\\\033[30m...\\\\033[${color}m|g")
    if [[ -e "$(realpath -qm "$1")" ]]
    then
	echolor "$2" "““$i””\t"$path_string"/““$(basename "$1")””"
    else
	echolor red "$i\t$full_name"
    fi
}

function view-spheres {
    function 2d {
	printf '%.2d' "$1"
    }
    for j in $(fd '^library' "$data_dir" | awk -F '-' '{print $2}' | sort | uniq)
    do
	no_of_docs="$(cat "$data_dir"/library-$j-* | wc -l)"
	no_of_unfin="$(cat "$data_dir"/library-$j-{current,reserve} | wc -l)"
	[[ "$no_of_docs" -eq 0 ]] && {
	    echo -n '00'
	    echolor white "/00: $j"
	    continue
	}
	[[ "$no_of_docs" -le 5 ]] && {
	    echo -n "$(2d "$no_of_unfin")"
	    echolor beige "/$(2d "$no_of_docs"): $j"
	    continue
	}
	[[ "$no_of_docs" -le 10 ]] && {
	    echo -n "$(2d "$no_of_unfin")"
	    echolor liteorange "/$(2d "$no_of_docs"): $j"
	    continue
	}
	[[ "$no_of_docs" -le 20 ]] && {
	    echo -n "$(2d "$no_of_unfin")"
	    echolor orange "/$(2d "$no_of_docs"): $j"
	    continue
	}
	[[ "$no_of_docs" -le 30 ]] && {
	    echo -n "$(2d "$no_of_unfin")"
	    echolor bloody "/$(2d "$no_of_docs"): $j"
	    continue
	}
	[[ "$no_of_docs" -le 40 ]] && {
	    echo -n "$(2d "$no_of_unfin")"
	    echolor purple "/$(2d "$no_of_docs"): $j"
	    continue
	}
	[[ "$no_of_docs" -le 50 ]] && {
	    echo -n "$(2d "$no_of_unfin")"
	    echolor blue "/$(2d "$no_of_docs"): $j"
	    continue
	}
	[[ "$no_of_docs" -gt 50 ]] && {
	    echo -n "$(2d "$no_of_unfin")"
	    echolor neonblue "/$(2d "$no_of_docs"): $j"
	    continue
	}
    done
    
    for j in $(fd '^retired' "$data_dir" | awk -F '-' '{print $2}' | sort | uniq)
    do
	echolor ashy "$(echo -e "\033[9m///// $j")"
    done
    exit
}

function sphere-switcher {
    [[ "$1" = '.' ]] && view-spheres
    grep -q ':' <<< "$1" && {
	new_sphere="$(awk -F ':' '{print $2}' <<< "$1" | kebab | tr -d '-')"
	sphere_command="$(awk -F ':' '{print $1}' <<< "$1" | kebab | tr -d '-')"
    } || {
	new_sphere="$(kebab "$1" | tr -d '-')"
	sphere_command=switch
    }
    [[ -z "$new_sphere" ]] && {
	echolor red ":: Sphere name is empty."
	exit 1
    }
    case "$sphere_command" in
	"switch")
	    fd -q -- "library-$new_sphere-" "$data_dir" || {
		echolor red ":: Sphere ““$new_sphere”” does not exist. Create it like this: ““zas -s new:<name>””"
		exit 1
	    }
	    fd -q -- "retired-$new_sphere-" "$data_dir" && {
		echolor red ":: The sphere ““$new_sphere”” is retired. Recall it to work like this: ““zas -s recall:<name>””"
		exit 1
	    }
	    echo "$new_sphere" > "$sphere_file"
	    echolor purple ":: Sphere switched to ““$(sed 1q "$sphere_file")””"
	    exit 
	    ;;

	"new")
	    fd -q -- "library-$new_sphere-" "$data_dir" && {
		echolor red ":: Sphere ““$new_sphere”” already exists. Swicth to it like this: ““zas -s <name>””"
		exit 1
	    }
	    fd -q -- "retired-$new_sphere-" "$data_dir" && {
		echolor red ":: There is already a retired sphere called ““$new_sphere””. Recall it to work like this: ““zas -s recall:<name>””"
		exit 1
	    }
	    echo "$new_sphere" > "$sphere_file"
	    echolor purple ":: Sphere ““$(sed 1q "$sphere_file")”” switched to. Add a document to create sphere files."
	    exit
	    ;;
	"retire")
	    fd -q -- "library-$new_sphere-" "$data_dir" || {
		echolor red ":: Sphere ““$new_sphere”” does not exist for it to be retired. Create it like this: ““zas -s new:<name>””"
		exit 1
	    }
	    fd -q -- "retired-$new_sphere-" "$data_dir" && {
		echolor red ":: There is already a retired sphere called ““$new_sphere””. Uh oh. This is not supposed to happen."
		exit 1
	    }
	    [[ "$(sed 1q "$sphere_file")" = "$new_sphere" ]] && {
		echolor red ":: You cannot retire the currently selected sphere. Select another then retire this one."
		exit 1
	    }
	    rename -v -- library retired "$data_dir"/library-"$new_sphere"-*
	    echolor purple ":: Sphere ““$new_sphere”” has been retired."
	    ;;
	"recall")
	    fd -q -- "retired-$new_sphere-" "$data_dir" || {
		echolor red ":: Retired sphere ““$new_sphere”” does not exist for it to be recalled. Create it like this: ““zas -s new:<name>””"
		exit 1
	    }
	    fd -q -- "library-$new_sphere-" "$data_dir" && {
		echolor red ":: There is already an active sphere called ““$new_sphere””. Uh oh. This is not supposed to happen."
		exit 1
	    }
	    rename -v -- retired library "$data_dir"/retired-"$new_sphere"-*
	    echolor purple ":: Sphere ““$new_sphere”” has been recalled to infinite toil. Neoliberal utopia achieved."
	    ;;
	"archive")
	    fd -q -- "library-$new_sphere-" "$data_dir" || {
		echolor red ":: Sphere ““$new_sphere”” does not exist. Create it like this: ““zas -s new:<name>””"
		exit 1
	    }
	    cat "$data_dir"/library-"$new_sphere"-alldone >> "$data_dir"/archive-"$new_sphere"
	    echo -n > "$data_dir"/library-"$new_sphere"-alldone
	    echolor purple ":: Sphere ““$new_sphere”” has been archived. ALLDONE is now empty."
	    ;;
	*)
	    echolor red ":: Unknown command ““$sphere_command””."
	    exit 1
	    ;;
    esac   
}

shelf_source=0
shelf_target=0
while getopts 'movb:t:f:a:ds:' OPTION; do
    case "$OPTION" in
	"s") sphere-switcher "$OPTARG" ;;
	"f") shelf_source="$OPTARG" ;;
	"t") shelf_target="$OPTARG" ;;
	"o") open-study ;;
	"v") view-study ;;
	"b") bib-study "$OPTARG";;
	"d") delete-study ;;
	"a") add-study "$OPTARG" ;;
	"m") move-shelf ;;
	*) echo incorrect input; exit ;;
    esac
done
(( $OPTIND == 1 )) && open-study
